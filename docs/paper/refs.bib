@misc{W4b,
  title  = {Independent validation of picBunch at the v0.1 pipeline tip (W4/W4b)},
  author = {W4b worker},
  year   = {2026},
  note   = {Run pr24-20261102. W4b/RESULTS.md (mirror of W4/).
            picBunch at bfaa1e26 (experimental/mvp), rosi\_v100. ctest 8/8.
            Accuracy: shipped CLI vs indfield.py order 12 refine 3, relative
            per-component error per d = 2 to 32 cells, gamma 1 and 10, aspect
            1 and 4, single and 3-particle cloud. Relative 3e-4 crossover:
            d=12 (gamma 1 aspect 1), d=32 (gamma 1 aspect 4), none within 32
            for gamma 10 (plateau 6e-3). Judge metric is absolute-dominated:
            d=2 for every case. End-to-end timings with writer (20-cell box,
            gamma 10, 3 repeats): 1e4 total 22.00 ms; 1e6 total 47.15 ms.
            Determinism: md5 d3641d64, 15092736 bytes, bit-identical.
            gridUnitSI applied twice: 1e-6 grid gives 1e-12 m cell, aborts
            with max\_size exception. Fixed in v0.1.1 with an end-to-end test.},
}

