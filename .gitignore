# Build trees (CMakePresets puts every preset under build/<preset>)
/build/
/build-*/
/out/
/cmake-build-*/

# Fetched dependencies, if a user redirects FetchContent here
/_deps/
/.cache/

# CMake / editor artefacts
compile_commands.json
CMakeUserPresets.json
.cache/
.vscode/
.idea/
*.swp

# Generated data: tables, datasets, openPMD series, plots, logs
/tables/
/datasets/
/data/
*.npz
*.h5
*.hdf5
*.bp
# Raw BP5 simulation data: single steps and openPMD dataset directories
*.bp5
/particles_*.bp5/
*.json.tmp
*.log

# Reduced figure data committed so the paper figures are reproducible
!docs/paper/data/**/*.npz

# Python byte-compile artefacts (tools/velocity-bins/*.py)
__pycache__/
*.pyc
